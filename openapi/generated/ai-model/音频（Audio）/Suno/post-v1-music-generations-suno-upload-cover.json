{
  "openapi": "3.1.0",
  "info": {
    "title": "上传音频并翻唱",
    "version": "1.0.0",
    "description": "上传公网音频 URL，并使用 Suno V6 生成翻唱。直接使用公开音频，无需先调用 `suno-upload`。提交后返回 `task_id`，通过任务查询接口取结果。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "上传音频并翻唱",
        "description": "上传公网音频 URL，并使用 Suno V6 生成翻唱。\n\n- 直接使用公开音频，无需先调用 `suno-upload`。`audio_url` 必填（公网 HTTP(S) 直链，建议原音频不超过 8 分钟）。本地路径、`blob:` URL 和需要登录的页面链接不可用。\n- `version`：`v6` / `v6-wild` / `v6-mini`，省略默认 `v6`。使用 `custom_model_id` 时省略 `version`。\n- `custom_model_id` 与 `version`、`persona_id` 互斥。\n- 建议显式传 `custom`。`custom=false` 时 `gpt_description` 必填（不超过 3000 字）；`custom=true` 且 `instrumental=false` 时 `prompt` 必填（不超过 5000 字）。\n- `duration_s` 仅自定义模式，范围 10–360 秒。`max_mode=true` 要求自定义模式，按普通售价的 2 倍计费。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-upload-cover",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-upload-cover",
                    "description": "固定填写 `suno-upload-cover`。",
                    "examples": ["suno-upload-cover"]
                  },
                  "audio_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "公网可访问的 HTTP(S) 音频直链，建议原音频不超过 8 分钟。本地路径、`blob:` URL 和需要登录的页面链接不可用。"
                  },
                  "version": {
                    "type": "string",
                    "enum": ["v6", "v6-wild", "v6-mini"],
                    "default": "v6",
                    "description": "公共版本：`v6` / `v6-wild` / `v6-mini`。省略默认 `v6`。使用 `custom_model_id` 时省略。"
                  },
                  "custom_model_id": {
                    "type": "string",
                    "description": "创建模型任务返回的完整 UUID。与 `version`、`persona_id` 互斥。"
                  },
                  "custom": {
                    "type": "boolean",
                    "description": "建议显式发送。`false` 使用 `gpt_description`；`true` 使用歌词和风格字段。"
                  },
                  "instrumental": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否生成纯音乐。`custom=true` 且本字段为 `false` 时，`prompt` 必填。"
                  },
                  "gpt_description": {
                    "type": "string",
                    "maxLength": 3000,
                    "description": "灵感描述，`custom=false` 时必填，不超过 3000 个字符。"
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 5000,
                    "description": "自定义模式歌词，不超过 5000 个字符。"
                  },
                  "tags": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "风格描述，不超过 1000 个字符。"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 80,
                    "description": "标题，不超过 80 个字符。"
                  },
                  "negative_tags": {
                    "type": "string",
                    "description": "不希望出现的风格。"
                  },
                  "style_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "风格权重，范围 0–1。"
                  },
                  "weirdness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "创意度权重，范围 0–1。"
                  },
                  "audio_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "音频权重，范围 0–1。"
                  },
                  "auto_lyrics": {
                    "type": "boolean",
                    "description": "是否对输入歌词进行二次创作。"
                  },
                  "vocal_gender": {
                    "type": "string",
                    "enum": ["Male", "Female"],
                    "description": "人声性别：`Male` / `Female`。"
                  },
                  "persona_id": {
                    "type": "string",
                    "description": "Persona ID，与 `custom_model_id` 互斥。"
                  },
                  "duration_s": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 360,
                    "description": "目标生成时长，范围 10–360 秒，仅自定义模式可用。"
                  },
                  "variety": {
                    "type": "string",
                    "enum": ["off", "normal", "high", "extra", "max"],
                    "description": "风格变化程度：`off` / `normal` / `high` / `extra` / `max`。"
                  },
                  "max_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否启用 Max 模式。启用时要求自定义模式，并按普通售价的 2 倍计费。"
                  },
                  "audio_format": {
                    "type": "string",
                    "enum": ["mp3", "m4a", "wav"],
                    "description": "输出格式：`mp3` / `m4a` / `wav`。"
                  }
                },
                "required": ["model", "audio_url"]
              },
              "examples": {
                "suno-upload-cover": {
                  "summary": "上传音频并翻唱",
                  "value": {
                    "model": "suno-upload-cover",
                    "version": "v6",
                    "audio_url": "https://example.com/reference.mp3",
                    "custom": true,
                    "instrumental": true,
                    "tags": "piano, ambient",
                    "duration_s": 120,
                    "variety": "normal",
                    "audio_format": "m4a"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "description": "响应状态码。", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "description": "提交结果，读取 `data[0].task_id` 并轮询任务查询接口。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [{ "status": "submitted", "task_id": "task_01M24YMN4EV04M84R5QYM77R1E" }]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "audio_url is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
