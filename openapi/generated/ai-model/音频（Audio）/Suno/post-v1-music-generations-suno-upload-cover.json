{
  "openapi": "3.1.0",
  "info": {
    "title": "上传音频并翻唱",
    "version": "1.0.0",
    "description": "直接用公网音频 URL 生成翻唱，无需先 `suno-upload`。`audio_url` 必填。版本 `v6` / `v6-wild` / `v6-mini`。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "上传音频并翻唱",
        "description": "上传公网音频 URL，并用 Suno V6 生成翻唱。\n\n- 无需先调用 `suno-upload`。`audio_url` 必填（公网 HTTP(S) 直链，建议不超过 8 分钟）。不要传本地路径或 `blob:` URL。\n- `version`：`v6` / `v6-wild` / `v6-mini`，默认 `v6`；与 `custom_model_id`、`persona_id` 互斥。\n- 建议显式传 `custom`。`custom=false` 时 `gpt_description` 必填；`custom=true && instrumental=false` 时 `prompt` 必填。\n- `duration_s` 仅自定义模式，范围 10–360。`max_mode` 要求自定义模式，2 倍计费。新请求用 `weirdness`。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-upload-cover",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-upload-cover", "description": "固定填写 `suno-upload-cover`。", "examples": ["suno-upload-cover"] },
                  "audio_url": { "type": "string", "format": "uri", "description": "公网音频直链，必填。" },
                  "version": { "type": "string", "enum": ["v6", "v6-wild", "v6-mini"], "default": "v6" },
                  "custom_model_id": { "type": "string", "description": "自定义模型 UUID，与 `version`、`persona_id` 互斥。" },
                  "custom": { "type": "boolean", "description": "建议显式发送。`false` 用 `gpt_description`；`true` 用歌词和风格字段。" },
                  "instrumental": { "type": "boolean", "default": false, "description": "`custom=true` 且本字段为 `false` 时 `prompt` 必填。" },
                  "gpt_description": { "type": "string", "description": "`custom=false` 时必填。" },
                  "prompt": { "type": "string" },
                  "tags": { "type": "string" },
                  "title": { "type": "string" },
                  "negative_tags": { "type": "string" },
                  "style_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "weirdness": { "type": "number", "minimum": 0, "maximum": 1, "description": "创意度。新请求用本字段。" },
                  "weirdness_constraint": { "type": "number", "minimum": 0, "maximum": 1 },
                  "audio_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "auto_lyrics": { "type": "boolean" },
                  "vocal_gender": { "type": "string", "enum": ["Male", "Female"] },
                  "persona_id": { "type": "string", "description": "Persona ID，与 `custom_model_id` 互斥。" },
                  "duration_s": { "type": "integer", "minimum": 10, "maximum": 360, "description": "目标时长 10–360 秒，仅自定义模式。" },
                  "variety": { "type": "string", "enum": ["off", "normal", "high", "extra", "max"] },
                  "max_mode": { "type": "boolean", "default": false, "description": "Max 模式，启用要求自定义模式，2 倍计费。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"] }
                },
                "required": ["model", "audio_url"]
              },
              "examples": {
                "suno-upload-cover": {
                  "summary": "上传音频并翻唱",
                  "value": {
                    "model": "suno-upload-cover",
                    "version": "v6",
                    "audio_url": "https://example.com/reference.mp3",
                    "custom": true,
                    "instrumental": true,
                    "tags": "piano, ambient",
                    "duration_s": 120,
                    "variety": "normal",
                    "audio_format": "m4a"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_01M24YMN4EV04M84R5QYM77R1E" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "audio_url is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
