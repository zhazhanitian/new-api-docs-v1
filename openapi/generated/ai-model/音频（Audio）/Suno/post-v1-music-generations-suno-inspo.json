{
  "openapi": "3.1.0",
  "info": {
    "title": "灵感生成",
    "version": "1.0.0",
    "description": "用 1–4 段公网音频 URL 作为灵感参考生成新歌，不走 `task_id`。版本 `v6` / `v6-wild` / `v6-mini`，默认 `v6`。不要发送 `custom`、`instrumental`、`gpt_description`、`persona_id` 或目标时长字段。新请求用 `weirdness`。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "灵感生成",
        "description": "用 1–4 段公网音频作为灵感参考生成新歌（直接给音频 URL，不走 `task_id`）。\n\n- 提交成功后返回 MAPI 公开任务 ID，通过 `GET /v1/music/generations/{task_id}` 轮询。\n- `version`：`v6` / `v6-wild` / `v6-mini`，省略默认 `v6`；与 `custom_model_id` 互斥。\n- 不要发送 `custom`、`instrumental`、`gpt_description`、`persona_id` 或目标时长字段。\n- 操作接口创意度字段为 `weirdness`（兼容旧名 `weirdness_constraint`）。\n- `max_mode=true` 按普通售价 2 倍计费；`variety: \"max\"` 不会自动开启 Max。\n- 完成后在 `result.music[]` 取 `audio_url`。进度 0–100，不保证固定节点。",
        "operationId": "suno-inspo",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-inspo",
                    "description": "固定填写 `suno-inspo`。",
                    "examples": ["suno-inspo"]
                  },
                  "audio_urls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "description": "1–4 个可公开访问的音频 URL 数组。"
                  },
                  "version": {
                    "type": "string",
                    "description": "公共版本：`v6` / `v6-wild` / `v6-mini`；省略时默认 `v6`。使用 `custom_model_id` 时省略本字段。",
                    "examples": ["v6"],
                    "enum": ["v6", "v6-wild", "v6-mini"],
                    "default": "v6"
                  },
                  "custom_model_id": {
                    "type": "string",
                    "description": "创建模型任务返回的完整 UUID，与 `version` 互斥。"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "歌词 / 内容。"
                  },
                  "title": {
                    "type": "string",
                    "description": "标题。"
                  },
                  "tags": {
                    "type": "string",
                    "description": "风格标签。"
                  },
                  "negative_tags": {
                    "type": "string",
                    "description": "排除的风格标签。"
                  },
                  "style_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "风格权重，0.00–1.00。"
                  },
                  "weirdness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "创意度权重，0.00–1.00。新请求请使用本字段；兼容旧名 `weirdness_constraint`。"
                  },
                  "weirdness_constraint": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "`weirdness` 的兼容旧名。新请求请改用 `weirdness`。"
                  },
                  "audio_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "音频权重，0.00–1.00。"
                  },
                  "vocal_gender": {
                    "type": "string",
                    "description": "人声性别：`Male` / `Female`。",
                    "enum": ["Male", "Female"]
                  },
                  "auto_lyrics": {
                    "type": "boolean",
                    "description": "`true` 表示对输入歌词进行二次创作。"
                  },
                  "variety": {
                    "type": "string",
                    "description": "风格变化程度。可省略。",
                    "enum": ["off", "normal", "high", "extra", "max"]
                  },
                  "max_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否启用 Max 模式；启用后按普通售价 2 倍计费。"
                  },
                  "audio_format": {
                    "type": "string",
                    "description": "输出音频格式。",
                    "enum": ["mp3", "m4a", "wav"]
                  }
                },
                "required": ["model", "audio_urls"]
              },
              "examples": {
                "suno-inspo": {
                  "summary": "灵感生成",
                  "value": {
                    "model": "suno-inspo",
                    "version": "v6",
                    "audio_urls": [
                      "https://example.com/reference-1.mp3",
                      "https://example.com/reference-2.wav"
                    ],
                    "tags": "dreamy pop"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": ["task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"]
                          }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误，例如 audio_urls 数量不在 1–4",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "inspo requires 1-4 audio_urls, got 0",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}
