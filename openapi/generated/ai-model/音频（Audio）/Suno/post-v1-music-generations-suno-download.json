{
  "openapi": "3.1.0",
  "info": {
    "title": "下载音频文件",
    "version": "1.0.0",
    "description": "将已有歌曲下载为 MP3、M4A 或 WAV。替代已下架的 `suno-wav`。`formats` 与 `format` 二选一。完成后读取 `result.files[]`。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "下载音频文件",
        "description": "将 Suno 歌曲下载为 MP3、M4A 或 WAV。\n\n- 用源任务 `task_id` + `audio_index`（默认 1）指定要下载的歌曲。源须已完成且含可下载音轨；歌词、BPM 等纯文本任务无法下载。\n- **无版本维度**：不要传 `version`。\n- `formats`（数组）与 `format`（单数）二选一；两者都空则 400。支持 `mp3` / `m4a` / `wav`，可一次请求多种格式。\n- 旧 `suno-wav` 已下架，请改用本模型。\n- 提交返回的是**下载任务** `task_id`，与源歌曲 `task_id` 不同。完成后读取 `result.files[]`（`format` + `url`）。`result.wavUrl` 仅兼容旧接口，新代码不要用。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-download",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-download", "description": "固定填写 `suno-download`。", "examples": ["suno-download"] },
                  "task_id": { "type": "string", "description": "源歌曲任务 ID，必填。须已完成且含可下载音轨。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1, "description": "源任务 `music[]` 第几首，1-based，默认 1。" },
                  "formats": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "enum": ["mp3", "m4a", "wav"] },
                    "description": "要下载的格式数组，至少一项。可与 `format` 二选一。"
                  },
                  "format": { "type": "string", "enum": ["mp3", "m4a", "wav"], "description": "只下载一种格式时可用本字段代替 `formats`。" }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-download": {
                  "summary": "下载多种格式",
                  "value": {
                    "model": "suno-download",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "formats": ["mp3", "wav"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string", "description": "下载任务 ID，用于查询；与源歌曲 task_id 不同。" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误、未指定格式或源任务无法下载",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "suno-download requires at least one format (use 'formats' or 'format')", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
