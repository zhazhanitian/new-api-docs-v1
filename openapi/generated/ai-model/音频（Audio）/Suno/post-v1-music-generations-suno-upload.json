{
  "openapi": "3.1.0",
  "info": {
    "title": "上传音频",
    "version": "1.0.0",
    "description": "把一段公网音频导入，得到可供后续翻唱、续写等操作引用的音轨；任务完成后，本任务 `task_id` 即可作为源任务，并使用 `audio_index=1` 引用音轨。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- 本模型无版本维度，不要传 `version`；即使传入也会被 MAPI 丢弃，不影响计费。\n- 请提供公网可直接访问的音频直链（`audio_file_path`）；缺失时提交期直接返回 400（不扣费）。\n- **已知限制**：不要上传**纯器乐（无人声）**音频，此类音频可能解析失败。\n- 任务完成后，可使用本任务 `task_id` 和 `audio_index=1` 作为翻唱、续写等后续操作的源音轨。\n- 建议每 3–5 秒查询一次公共任务接口；生成中状态为 `pending`，`progress` 值排队约 10、就绪约 50、完成为 100。\n- 失败时 `data.error.message` 为原因，平台自动退回预扣额度。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "上传音频",
        "description": "把一段公网音频导入，得到可供后续翻唱、续写等操作引用的音轨；任务完成后，本任务 `task_id` 即可作为源任务，并使用 `audio_index=1` 引用音轨。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- 本模型无版本维度，不要传 `version`；即使传入也会被 MAPI 丢弃，不影响计费。\n- 请提供公网可直接访问的音频直链（`audio_file_path`）；缺失时提交期直接返回 400（不扣费）。\n- **已知限制**：不要上传**纯器乐（无人声）**音频，此类音频可能解析失败。\n- 任务完成后，可使用本任务 `task_id` 和 `audio_index=1` 作为翻唱、续写等后续操作的源音轨。\n- 建议每 3–5 秒查询一次公共任务接口；生成中状态为 `pending`，`progress` 值排队约 10、就绪约 50、完成为 100。\n- 失败时 `data.error.message` 为原因，平台自动退回预扣额度。",
        "operationId": "suno-upload",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-upload",
                    "description": "固定填写 `suno-upload`。",
                    "examples": [
                      "suno-upload"
                    ]
                  },
                  "audio_file_path": {
                    "type": "string",
                    "description": "公网可直接访问的音频直链，**必填**；缺失时提交期直接返回 400（不扣费）。MAPI 会将该字段转换为上游需要的音频文件路径字段。",
                    "examples": [
                      "https://example.com/source.mp3"
                    ],
                    "format": "uri"
                  }
                },
                "required": [
                  "model",
                  "audio_file_path"
                ]
              },
              "examples": {
                "suno-upload": {
                  "summary": "上传音频",
                  "value": {
                    "model": "suno-upload",
                    "audio_file_path": "https://example.com/source.mp3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "task_id is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}