{
  "openapi": "3.1.0",
  "info": {
    "title": "上传音频",
    "version": "1.0.0",
    "description": "把公网音频导入为后续翻唱 / 续写等可引用的音轨。只收 JSON，不上传二进制。无版本维度，不要传 `version` 或 `audio_format`。完成后用本任务 `task_id` + `audio_index=1` 作源；结果可能只有 `audio_id`，不保证可播放 `audio_url`。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "上传音频",
        "description": "把公网音频导入，得到可供后续翻唱、续写等引用的音轨。\n\n- 只接收 JSON，不上传二进制文件。请先把音频放到对象存储，再填入 `audio_file_path`（MAPI 会转成上游 `audioFilePath`）。\n- 必须是可公开读取的 HTTP(S) 直链；本机路径与 `blob:` URL 不可用。\n- 无版本维度，不要发送 `version`、`audio_format` 或未列出的参数。\n- 完成后使用本任务 `task_id` + `audio_index=1` 作为其它操作的源；上传结果可能只有 `audio_id`，不保证返回可播放的 `audio_url`。",
        "operationId": "suno-upload",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-upload",
                    "description": "固定填写 `suno-upload`。",
                    "examples": [
                      "suno-upload"
                    ]
                  },
                  "audio_file_path": {
                    "type": "string",
                    "description": "已上传到对象存储、可公开读取的音频 HTTP(S) 直链，必填。本机路径与 `blob:` URL 不可用。MAPI 会转换为上游 `audioFilePath`。",
                    "examples": [
                      "https://example.com/source.mp3"
                    ],
                    "format": "uri"
                  }
                },
                "required": [
                  "model",
                  "audio_file_path"
                ]
              },
              "examples": {
                "suno-upload": {
                  "summary": "上传音频",
                  "value": {
                    "model": "suno-upload",
                    "audio_file_path": "https://example.com/source.mp3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "task_id is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}