{
  "openapi": "3.1.0",
  "info": {
    "title": "查询 Suno 任务",
    "version": "1.0.0",
    "description": "查询 Suno V6 异步任务的状态、进度、计费信息和结果。建议首次等待约 3 秒，之后每 5–10 秒轮询一次，直到状态变为 `SUCCESS` 或 `FAILURE`。不要因网络超时自动重发收费的 POST 请求。`UNKNOWN` 时保留任务 ID 手动刷新，不要自动新建任务。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations/{task_id}": {
      "get": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "查询 Suno 任务",
        "description": "查询 Suno V6 异步任务的状态、进度、计费信息和结果。\n\n- 建议首次等待约 3 秒，之后每 5–10 秒查询一次，直到 `status` 为 `SUCCESS` 或 `FAILURE`。\n- 页面刷新后可继续使用同一个任务 ID；不要因网络超时自动重发收费的 POST 请求。\n- 上游查询状态会映射为平台状态：`pending`→`QUEUED`，`processing`→`IN_PROGRESS`，`completed`→`SUCCESS`，`failed`→`FAILURE`，`unknown`→`UNKNOWN`。\n- `progress` 通常为 0–100，是否完成以 `status` 为准，不再保证 10→50→100 固定节点。\n- 音乐类结果通常在 `result.music[]`；下载、歌词、MIDI、Persona、自定义模型等有各自结构。\n- `result.music[]` 可能含 `status`、`display_tags`、`negative_tags`、`style_weight`、`weirdness_constraint`、`audio_weight`。返回多少首按实际数组展示，不要固定为 2。\n- `UNKNOWN` 时保留任务 ID 并允许手动刷新，不要自动创建新任务。当前没有取消已提交任务的端点。",
        "operationId": "get-suno-task",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "提交接口返回的 MAPI 公开任务 ID",
            "schema": {
              "type": "string"
            },
            "example": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": ["success"]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "MAPI 公开任务 ID"
                        },
                        "action": {
                          "type": "string",
                          "description": "提交时使用的 `suno-*` 模型 ID"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "NOT_START",
                            "SUBMITTED",
                            "QUEUED",
                            "IN_PROGRESS",
                            "SUCCESS",
                            "FAILURE",
                            "UNKNOWN"
                          ],
                          "description": "`SUBMITTED`：已提交上游（提交响应可能仍为此状态）；`QUEUED`：上游排队（pending）；`IN_PROGRESS`：处理中（processing）；`SUCCESS`：完成（completed）；`FAILURE`：失败（failed）；`UNKNOWN`：状态未知，保留任务 ID 手动刷新，不要自动新建任务。"
                        },
                        "fail_reason": {
                          "type": "string",
                          "description": "失败原因；非失败任务为空字符串"
                        },
                        "progress": {
                          "type": "string",
                          "description": "任务进度百分比字符串。V6 进度通常为 0–100，不再保证 10 / 50 / 100 固定节点；是否完成以 `status` 为准。",
                          "examples": ["0%", "37%", "100%"]
                        },
                        "amount": {
                          "type": "string",
                          "description": "人民币计费金额，保留 6 位小数"
                        },
                        "submit_time": {
                          "type": "integer",
                          "description": "提交时间，Unix 秒"
                        },
                        "start_time": {
                          "type": "integer",
                          "description": "开始处理时间，Unix 秒"
                        },
                        "finish_time": {
                          "type": "integer",
                          "description": "完成时间，Unix 秒；未完成时为 0"
                        },
                        "result": {
                          "type": "object",
                          "description": "任务结果，仅在任务完成后存在。字段结构因 `action` 不同而不同，直接透传上游返回内容。音乐类通常为 `music[]`（含 `audio_url`、`status`、`display_tags`、`negative_tags`、权重等，数量不要固定为 2）；标签增强为 `upsampled_tags`；下载为 `files[]`；歌词优先 `lyrics[]`；MIDI 为 `state`/`instruments[]`；Persona 为 `persona_id`；自定义模型为 `model_id`；MV 优先 `videoUrl`。",
                          "additionalProperties": true
                        }
                      },
                      "required": ["task_id", "action", "status", "fail_reason", "progress", "amount", "submit_time", "start_time", "finish_time"]
                    }
                  },
                  "required": ["code", "data"]
                },
                "examples": {
                  "submitted": {
                    "summary": "已提交",
                    "value": {
                      "code": "success",
                      "message": "",
                      "data": {
                        "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw",
                        "action": "suno-music",
                        "status": "SUBMITTED",
                        "fail_reason": "",
                        "progress": "10%",
                        "amount": "0.730000",
                        "submit_time": 1787018400,
                        "start_time": 1787018410,
                        "finish_time": 0
                      }
                    }
                  },
                  "queued": {
                    "summary": "排队中",
                    "value": {
                      "code": "success",
                      "message": "",
                      "data": {
                        "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw",
                        "action": "suno-music",
                        "status": "QUEUED",
                        "fail_reason": "",
                        "progress": "50%",
                        "amount": "0.730000",
                        "submit_time": 1787018400,
                        "start_time": 1787018410,
                        "finish_time": 0
                      }
                    }
                  },
                  "processing": {
                    "summary": "处理中",
                    "value": {
                      "code": "success",
                      "message": "",
                      "data": {
                        "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw",
                        "action": "suno-music",
                        "status": "IN_PROGRESS",
                        "fail_reason": "",
                        "progress": "70%",
                        "amount": "0.730000",
                        "submit_time": 1787018400,
                        "start_time": 1787018410,
                        "finish_time": 0
                      }
                    }
                  },
                  "successMusic": {
                    "summary": "音乐任务成功",
                    "value": {
                      "code": "success",
                      "message": "",
                      "data": {
                        "task_id": "task_nNfDw9zQVVrDiL70FM8xgHyKcwBrVKBY",
                        "action": "suno-music",
                        "status": "SUCCESS",
                        "fail_reason": "",
                        "progress": "100%",
                        "amount": "0.365000",
                        "submit_time": 1787044643,
                        "start_time": 1787044673,
                        "finish_time": 1787044787,
                        "result": {
                          "music": [
                            {
                              "audio_id": "8daa79e6-e61f-4f46-83fb-b88383682bfe",
                              "audio_url": "https://getapib.org/audio/9998212955231777-f80f5cd1-8f7f-4546-9e8f-46cfde476f4f-8daa79e6-e61f-4f46-83fb-b88383682bfe.mp3",
                              "duration": 194,
                              "image_url": "https://cdn.ttapi.io/suno/20260818/8682aad03347433eaf424024e497732b.jpg",
                              "image_large_url": "https://cdn.ttapi.io/suno/20260818/8682aad03347433eaf424024e497732b.jpg",
                              "lyrics": "[Verse 1]\n我把灯关小一点\n让雨落进窗边\n...",
                              "tags": "Lo-fi piano ballad with a loose trip-hop sway, soft brushed drums, and rain texture under the keys",
                              "display_tags": "lo-fi, piano, ambient",
                              "negative_tags": "",
                              "style_weight": 0.7,
                              "weirdness_constraint": 0,
                              "audio_weight": 0.4,
                              "title": "雨窗慢拍",
                              "status": "complete"
                            },
                            {
                              "audio_id": "d6efab32-86f9-4042-8bd2-0bd01f531a6d",
                              "audio_url": "https://getapib.org/audio/9998212955230086-083fcb9d-7c98-4148-9ea9-c3ed25e57a15-d6efab32-86f9-4042-8bd2-0bd01f531a6d.mp3",
                              "duration": 185.72,
                              "image_url": "https://cdn.ttapi.io/suno/20260818/17bfa4e4938c4c55a4ff9c725b096f2d.jpg",
                              "image_large_url": "https://cdn.ttapi.io/suno/20260818/17bfa4e4938c4c55a4ff9c725b096f2d.jpg",
                              "lyrics": "[Verse 1]\n我把灯关小一点\n让雨落进窗边\n...",
                              "tags": "Lo-fi piano ballad with a loose trip-hop sway, soft brushed drums, and rain texture under the keys",
                              "display_tags": "lo-fi, piano, ambient",
                              "negative_tags": "",
                              "style_weight": 0.7,
                              "weirdness_constraint": 0,
                              "audio_weight": 0.4,
                              "title": "雨窗慢拍",
                              "status": "complete"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "successTags": {
                    "summary": "标签增强任务成功",
                    "value": {
                      "code": "success",
                      "message": "",
                      "data": {
                        "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw",
                        "action": "suno-upsample-tags",
                        "status": "SUCCESS",
                        "fail_reason": "",
                        "progress": "100%",
                        "amount": "0.050000",
                        "submit_time": 1787018400,
                        "start_time": 1787018410,
                        "finish_time": 1787018450,
                        "result": {
                          "upsampled_tags": "lo-fi hip hop, warm vinyl, rainy night, mellow piano, dusty keys, slow tempo, chill beats, late night vibes"
                        }
                      }
                    }
                  },
                  "failed": {
                    "summary": "任务失败",
                    "value": {
                      "code": "success",
                      "message": "",
                      "data": {
                        "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw",
                        "action": "suno-extend",
                        "status": "FAILURE",
                        "fail_reason": "source task is not ready",
                        "progress": "100%",
                        "amount": "0.000000",
                        "submit_time": 1787018400,
                        "start_time": 1787018410,
                        "finish_time": 1787018450
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "任务不存在或不属于当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "examples": ["task_not_exist"]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": ["code", "message"]
                },
                "example": {
                  "code": "task_not_exist",
                  "message": "task_not_exist",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}
