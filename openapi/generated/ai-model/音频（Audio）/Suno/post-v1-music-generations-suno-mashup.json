{
  "openapi": "3.1.0",
  "info": {
    "title": "生成混搭",
    "version": "1.0.0",
    "description": "把两首已有歌曲混搭再创作。`task_ids` 须恰好 2 个。版本 `v6` / `v6-wild` / `v6-mini`。不支持目标时长。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "生成混搭",
        "description": "把两首已有歌曲混搭再创作。\n\n- `task_ids` 须**恰好 2 个**源任务 ID，数量不对提交期直接 400。可选 `audio_indexes` 与之平行（1-based，默认都取 1）。\n- `version`：`v6` / `v6-wild` / `v6-mini`，省略默认 `v6`。使用 `custom_model_id` 时省略。`custom_model_id` 与 `version`、`persona_id` 互斥。\n- `custom` 决定哪些字段生效。不传时按此推断：有 `prompt` → `true`；无 `prompt` 但有 `gpt_description` → `false`；否则有 `tags` 或 `title` → `true`。已提交字段无论当前模式是否生效，都须满足类型、范围和长度。\n- `custom=true` 时 `prompt`、`title`、`tags`、`negative_tags`、`auto_lyrics`、`style_weight`、`weirdness`、`audio_weight`、`persona_id` 生效，`gpt_description` 被忽略。`custom=true` 且 `instrumental=false` 时 `prompt` 必填。\n- `custom=false` 时只读 `gpt_description`（必填，缺失提交期 400、不扣费）。`vocal_gender` 两种模式都生效。\n- 不支持目标时长。`max_mode` 启用要求自定义模式，按普通售价的 2 倍计费。创意度用 `weirdness`，兼容旧名 `weirdness_constraint`。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-mashup",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-mashup",
                    "description": "固定填写 `suno-mashup`。",
                    "examples": ["suno-mashup"]
                  },
                  "task_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "string" },
                    "description": "2 个源音轨所属任务的 ID，须恰好 2 个。数量不对提交期直接返回 400。"
                  },
                  "audio_indexes": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 },
                    "description": "与 `task_ids` 平行，指定各任务取结果 `music[]` 第几首（1-based，默认都取 1）。"
                  },
                  "instrumental": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否纯器乐。`true` 表示无人声；省略默认 `false`（要人声）。"
                  },
                  "version": {
                    "type": "string",
                    "enum": ["v6", "v6-wild", "v6-mini"],
                    "default": "v6",
                    "description": "公共版本：`v6` / `v6-wild` / `v6-mini`。省略默认 `v6`。使用 `custom_model_id` 时省略。"
                  },
                  "custom_model_id": {
                    "type": "string",
                    "description": "创建模型任务返回的完整 UUID。与 `version`、`persona_id` 互斥。"
                  },
                  "custom": {
                    "type": "boolean",
                    "description": "`true` 为自定义模式，`prompt` 作歌词；`false` 为灵感模式，用 `gpt_description`。省略时按内容推断：有 `prompt` → `true`；无 `prompt` 但有 `gpt_description` → `false`；否则有 `tags` 或 `title` → `true`。"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "歌词。`custom=true` 且 `instrumental=false` 时必填。灵感模式下不生效，但已提交值仍须满足长度要求。"
                  },
                  "gpt_description": {
                    "type": "string",
                    "description": "灵感提示词。`custom=false` 时必填，缺失提交期直接返回 400、不扣费。`custom=true` 时被忽略。"
                  },
                  "title": {
                    "type": "string",
                    "description": "标题。仅 `custom=true` 时生效。"
                  },
                  "tags": {
                    "type": "string",
                    "description": "风格标签。仅 `custom=true` 时生效。"
                  },
                  "negative_tags": {
                    "type": "string",
                    "description": "要排除的风格标签。仅 `custom=true` 时生效。"
                  },
                  "auto_lyrics": {
                    "type": "boolean",
                    "description": "是否对输入歌词进行二次创作。仅 `custom=true` 时生效。"
                  },
                  "style_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "风格权重，范围 0.00–1.00。越界提交期直接返回 400。仅 `custom=true` 时生效。"
                  },
                  "weirdness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "创意权重，范围 0.00–1.00。兼容旧名 `weirdness_constraint`；新请求请使用 `weirdness`。"
                  },
                  "audio_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "音频权重，范围 0.00–1.00。仅 `custom=true` 时生效。"
                  },
                  "vocal_gender": {
                    "type": "string",
                    "enum": ["Male", "Female"],
                    "description": "人声性别：`Male` / `Female`。两种模式都生效。"
                  },
                  "persona_id": {
                    "type": "string",
                    "description": "Persona 风格 ID。仅 `custom=true` 时生效，与 `custom_model_id` 互斥。"
                  },
                  "variety": {
                    "type": "string",
                    "enum": ["off", "normal", "high", "extra", "max"],
                    "description": "风格变化程度：`off` / `normal` / `high` / `extra` / `max`。可省略。"
                  },
                  "max_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否启用 Max 模式。启用时要求自定义模式，并按普通售价的 2 倍计费。"
                  },
                  "audio_format": {
                    "type": "string",
                    "enum": ["mp3", "m4a", "wav"],
                    "description": "输出音频格式：`mp3` / `m4a` / `wav`。本接口不支持目标时长字段。"
                  }
                },
                "required": ["model", "task_ids"]
              },
              "examples": {
                "suno-mashup": {
                  "summary": "生成混搭",
                  "value": {
                    "model": "suno-mashup",
                    "task_ids": ["task_01ABC", "task_01DEF"],
                    "audio_indexes": [1, 2],
                    "custom": true,
                    "prompt": "upbeat mashup of the two tracks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "description": "响应状态码。", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "description": "提交结果，读取 `data[0].task_id` 并轮询任务查询接口。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"], "description": "任务状态。`submitted` 表示已提交。" },
                          "task_id": { "type": "string", "description": "任务 ID，用于轮询 `GET /v1/music/generations/{task_id}`。" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [{ "status": "submitted", "task_id": "task_01K8SGYNNNVBQTXNR4MM964S7K" }]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源数量不对",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "mashup requires exactly 2 task_ids, got 1", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
