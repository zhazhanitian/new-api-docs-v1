{
  "openapi": "3.1.0",
  "info": {
    "title": "上传音频并延伸",
    "version": "1.0.0",
    "description": "直接用公网音频 URL 延伸歌曲，无需先 `suno-upload`。必填 `audio_url` + `continue_at`。固定自定义模式，不要发 `custom`、`instrumental`、`gpt_description`。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "上传音频并延伸",
        "description": "上传公网音频 URL，并从指定位置用 Suno V6 延伸歌曲。\n\n- 无需先调用 `suno-upload`。必填 `audio_url`（公网 HTTP(S) 直链，建议不超过 8 分钟）和 `continue_at`（≥1 秒且严格小于源时长）。\n- **固定自定义模式**：不要发送 `custom`、`instrumental` 或 `gpt_description`。\n- `version`：`v6` / `v6-wild` / `v6-mini`，默认 `v6`；与 `custom_model_id`、`persona_id` 互斥。\n- `duration_s` 目标时长 10–360 秒。`max_mode=true` 按 2 倍计费。新请求用 `weirdness`。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-upload-extend",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-upload-extend", "description": "固定填写 `suno-upload-extend`。", "examples": ["suno-upload-extend"] },
                  "audio_url": { "type": "string", "format": "uri", "description": "公网音频直链，必填。不要传本地路径或 `blob:` URL。" },
                  "continue_at": { "type": "number", "minimum": 1, "description": "延伸起点（秒），必填，须 ≥1 且小于源时长。" },
                  "version": { "type": "string", "enum": ["v6", "v6-wild", "v6-mini"], "default": "v6" },
                  "custom_model_id": { "type": "string", "description": "自定义模型 UUID，与 `version`、`persona_id` 互斥。" },
                  "prompt": { "type": "string", "description": "延伸段歌词，省略时按纯音乐延伸。" },
                  "tags": { "type": "string" },
                  "title": { "type": "string" },
                  "negative_tags": { "type": "string" },
                  "style_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "weirdness": { "type": "number", "minimum": 0, "maximum": 1, "description": "创意度。新请求用本字段。" },
                  "weirdness_constraint": { "type": "number", "minimum": 0, "maximum": 1 },
                  "audio_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "auto_lyrics": { "type": "boolean" },
                  "vocal_gender": { "type": "string", "enum": ["Male", "Female"] },
                  "persona_id": { "type": "string", "description": "Persona ID，与 `custom_model_id` 互斥。" },
                  "duration_s": { "type": "integer", "minimum": 10, "maximum": 360, "description": "目标生成时长，10–360 秒。" },
                  "variety": { "type": "string", "enum": ["off", "normal", "high", "extra", "max"] },
                  "max_mode": { "type": "boolean", "default": false, "description": "Max 模式，2 倍计费。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"] }
                },
                "required": ["model", "audio_url", "continue_at"]
              },
              "examples": {
                "suno-upload-extend": {
                  "summary": "上传音频并延伸",
                  "value": {
                    "model": "suno-upload-extend",
                    "version": "v6-mini",
                    "audio_url": "https://example.com/reference.wav",
                    "continue_at": 30,
                    "prompt": "[Outro]\\n下一段旅途，我们一起走",
                    "tags": "acoustic pop",
                    "duration_s": 60,
                    "max_mode": true,
                    "audio_format": "mp3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_01M24YMN4EV04M84R5QYM77R1E" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "audio_url is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
