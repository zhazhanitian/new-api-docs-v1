{
  "openapi": "3.1.0",
  "info": {
    "title": "Persona",
    "version": "1.0.0",
    "description": "从已有音轨创建可复用的 Persona 风格，适用于保持后续歌曲的声音或风格一致性。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- 本模型无版本维度，不要传 `version`；即使传入也会被 MAPI 丢弃，不影响计费。\n- 使用产出源音轨的 `task_id` 和 `audio_index` 引用歌曲；`name` 为必填字段，缺失直接返回 400。\n- 可以绑定 `suno-vox` 提取结果（`vox_audio_id`）；绑定时，`vocal_start_s` 和 `vocal_end_s` 必须与提取该 Vox 时的截取区间一致。\n- 任务完成后，结果中包含创建的 Persona 信息。\n- 通常需要 30–120 秒，建议每 3–5 秒查询一次公共任务接口；生成中状态为 `pending`，`progress` 值排队约 10、就绪约 50、完成为 100。\n- 失败时 `data.error.message` 为原因，平台自动退回预扣额度。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "Persona",
        "description": "从已有音轨创建可复用的 Persona 风格，适用于保持后续歌曲的声音或风格一致性。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- 本模型无版本维度，不要传 `version`；即使传入也会被 MAPI 丢弃，不影响计费。\n- 使用产出源音轨的 `task_id` 和 `audio_index` 引用歌曲；`name` 为必填字段，缺失直接返回 400。\n- 可以绑定 `suno-vox` 提取结果（`vox_audio_id`）；绑定时，`vocal_start_s` 和 `vocal_end_s` 必须与提取该 Vox 时的截取区间一致。\n- 任务完成后，结果中包含创建的 Persona 信息。\n- 通常需要 30–120 秒，建议每 3–5 秒查询一次公共任务接口；生成中状态为 `pending`，`progress` 值排队约 10、就绪约 50、完成为 100。\n- 失败时 `data.error.message` 为原因，平台自动退回预扣额度。",
        "operationId": "suno-persona",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-persona",
                    "description": "固定填写 `suno-persona`。",
                    "examples": [
                      "suno-persona"
                    ]
                  },
                  "task_id": {
                    "type": "string",
                    "description": "产出源音轨那次任务的 `task_id`。缺失或上游无法解析源音轨时，提交期直接返回 400（不扣费）。",
                    "examples": [
                      "task_source123"
                    ]
                  },
                  "audio_index": {
                    "type": "integer",
                    "description": "源任务结果 `music[]` 中的音轨序号，使用 1-based 编号，默认 `1`。",
                    "examples": [
                      1
                    ],
                    "default": 1,
                    "minimum": 1
                  },
                  "name": {
                    "type": "string",
                    "description": "Persona 名称。**必填**，缺失时提交期直接返回 400。"
                  },
                  "description": {
                    "type": "string",
                    "description": "Persona 描述。"
                  },
                  "styles": {
                    "type": "string",
                    "description": "Persona 风格。"
                  },
                  "vox_audio_id": {
                    "type": "string",
                    "description": "通过 `suno-vox` 提取操作得到的 Vox 音频 ID（「提取 Vox」任务完成后的结果 ID）。"
                  },
                  "vocal_start_s": {
                    "type": "number",
                    "description": "人声截取起点（秒）。引用 `vox_audio_id` 时，必须与提取该 Vox 时的起点一致。"
                  },
                  "vocal_end_s": {
                    "type": "number",
                    "description": "人声截取终点（秒）。引用 `vox_audio_id` 时，必须与提取该 Vox 时的终点一致。"
                  }
                },
                "required": [
                  "model",
                  "task_id",
                  "name"
                ]
              },
              "examples": {
                "suno-persona": {
                  "summary": "Persona",
                  "value": {
                    "model": "suno-persona",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "name": "Warm Indie Vocal",
                    "description": "温暖、自然的独立流行人声",
                    "styles": "indie pop, warm vocal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "task_id is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}