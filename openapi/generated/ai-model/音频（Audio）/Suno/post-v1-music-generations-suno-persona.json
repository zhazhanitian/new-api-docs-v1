{
  "openapi": "3.1.0",
  "info": {
    "title": "Persona",
    "version": "1.0.0",
    "description": "基于已有歌曲直接创建可复用歌手 Persona。无版本维度。新流程无需先创建 Vox，不要传 `vox_audio_id`。完成后读取 `result.persona_id`。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "Persona",
        "description": "基于已有歌曲直接创建可复用的歌手 Persona。\n\n- 用产出源音轨那次任务的 `task_id` + `audio_index`（默认 1）引用源。`name` 必填。\n- **无版本维度**：不要传 `version`。\n- 对外字段仍用 `description`（平台会转成上游 `describe`）。\n- 不要传 `vox_audio_id`；新流程无需先创建 Vox。`vocal_start_s` 须 ≥0，建议与 `vocal_end_s` 成对提供，终点须大于起点且不超过源时长。\n- 完成后读取 `result.persona_id`。Persona ID 与自定义模型 ID 不同，不能作为 `model` 或 `custom_model_id` 使用。\n- 提交后通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-persona",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-persona", "description": "固定填写 `suno-persona`。", "examples": ["suno-persona"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1, "description": "源任务结果 `music[]` 第几首，1-based，默认 1。" },
                  "name": { "type": "string", "description": "Persona 名称，必填。" },
                  "description": { "type": "string", "description": "Persona 描述。对应上游 `describe`。" },
                  "styles": { "type": "string", "description": "风格。" },
                  "vocal_start_s": { "type": "number", "minimum": 0, "description": "人声片段起点（秒），须 ≥0。建议与 `vocal_end_s` 成对提供。" },
                  "vocal_end_s": { "type": "number", "description": "人声片段终点（秒），须大于起点且不超过源时长。" }
                },
                "required": ["model", "task_id", "name"]
              },
              "examples": {
                "suno-persona": {
                  "summary": "Persona",
                  "value": {
                    "model": "suno-persona",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "name": "My Persona",
                    "description": "温暖、自然的独立流行人声",
                    "styles": "pop"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "name is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
