{
  "openapi": "3.1.0",
  "info": {
    "title": "母带优化",
    "version": "1.0.0",
    "description": "对已生成歌曲做母带优化。无版本参数，不要传 `version`。不支持 `custom_model_id`、`max_mode`、`variety` 或目标时长。必填 `task_id`。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "母带优化",
        "description": "对已生成歌曲做母带优化，提升音质、清晰度与整体质感。\n\n- 源：`task_id` 必填 + `audio_index`（默认 1）。\n- **没有版本参数，请勿传入 `version`**。\n- 不支持 `custom_model_id`、`max_mode`、`variety` 或目标时长字段。\n- `variation_category`：`subtle` / `normal` / `high`。\n- 完成后从 `result.music[]` 取 `audio_url`。",
        "operationId": "suno-remaster",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-remaster", "description": "固定填写 `suno-remaster`。", "examples": ["suno-remaster"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1, "description": "源任务 `result.music[]` 第几首，1-based，默认 1。" },
                  "variation_category": { "type": "string", "enum": ["subtle", "normal", "high"], "description": "改编强度：`subtle` / `normal` / `high`。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"], "description": "输出音频格式。" }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-remaster": {
                  "summary": "母带优化",
                  "value": { "model": "suno-remaster", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw", "audio_index": 1, "variation_category": "normal" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
