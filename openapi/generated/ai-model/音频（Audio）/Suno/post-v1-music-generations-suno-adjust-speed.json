{
  "openapi": "3.1.0",
  "info": {
    "title": "调整速度",
    "version": "1.0.0",
    "description": "变速（不改音高，可配置）。无版本维度。`speed` 必填，范围 0.25–4。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "调整速度",
        "description": "变速（不改音高）。\n\n- 用 `task_id` + `audio_index`（默认 1）引用源音轨。\n- **无版本维度**：不要传 `version`。\n- `speed` 必填，范围 `0.25`～`4`（如 `1.25`）；缺失或越界直接 400。\n- `keep_pitch` 默认 `true`。`title` 默认 `Untitled`。\n- 完成后从 `result.music[]` 取处理后的 `audio_url`。通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-adjust-speed",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-adjust-speed", "description": "固定填写 `suno-adjust-speed`。", "examples": ["suno-adjust-speed"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1 },
                  "speed": { "type": "number", "minimum": 0.25, "maximum": 4, "description": "倍速，范围 0.25–4，必填。" },
                  "keep_pitch": { "type": "boolean", "default": true, "description": "变速时是否保持原音高，默认 `true`。" },
                  "title": { "type": "string", "default": "Untitled", "description": "标题，默认 `Untitled`。" }
                },
                "required": ["model", "task_id", "speed"]
              },
              "examples": {
                "suno-adjust-speed": {
                  "summary": "调整速度",
                  "value": {
                    "model": "suno-adjust-speed",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "speed": 1.25,
                    "keep_pitch": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "speed is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
