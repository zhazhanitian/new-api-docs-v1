{
  "openapi": "3.1.0",
  "info": {
    "title": "段落替换",
    "version": "1.0.0",
    "description": "替换歌曲的某一段（infill）。版本 `v6` / `v6-wild` / `v6-mini`。`start_s`、`end_s` 必填。不要发送 `custom`、`instrumental`、`auto_lyrics` 或旧编辑会话字段。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "段落替换",
        "description": "替换歌曲的某一段（infill）。\n\n- 用 `task_id` + `audio_index`（默认 1）引用源音轨。\n- `start_s`、`end_s` 必填，须满足 `0 ≤ start_s < end_s`；源时长已知时不能越界。\n- `version`：`v6` / `v6-wild` / `v6-mini`，默认 `v6`；与 `custom_model_id` 互斥。\n- `prompt` 是原歌词上下文，`infill_lyrics` 是替换片段的新歌词。\n- 不要发送 `custom`、`instrumental`、`auto_lyrics` 或旧编辑会话字段。\n- `max_mode=true` 按 2 倍计费。完成后从 `result.music[]` 取 `audio_url`。",
        "operationId": "suno-replace-section",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-replace-section", "description": "固定填写 `suno-replace-section`。", "examples": ["suno-replace-section"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1 },
                  "start_s": { "type": "number", "minimum": 0, "description": "替换起点（秒），必填。" },
                  "end_s": { "type": "number", "description": "替换终点（秒），必填。须满足 `0 ≤ start_s < end_s`。" },
                  "infill_lyrics": { "type": "string", "description": "替换段歌词。" },
                  "prompt": { "type": "string", "description": "上下文歌词。" },
                  "version": { "type": "string", "enum": ["v6", "v6-wild", "v6-mini"], "default": "v6" },
                  "custom_model_id": { "type": "string", "description": "自定义模型 UUID，与 `version` 互斥。" },
                  "title": { "type": "string" },
                  "tags": { "type": "string" },
                  "negative_tags": { "type": "string" },
                  "variety": { "type": "string", "enum": ["off", "normal", "high", "extra", "max"] },
                  "max_mode": { "type": "boolean", "default": false, "description": "Max 模式，2 倍计费。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"] }
                },
                "required": ["model", "task_id", "start_s", "end_s"]
              },
              "examples": {
                "suno-replace-section": {
                  "summary": "段落替换",
                  "value": {
                    "model": "suno-replace-section",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "start_s": 30,
                    "end_s": 45,
                    "version": "v6",
                    "infill_lyrics": "[Chorus]\\nSing into the morning light",
                    "tags": "anthemic pop"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
