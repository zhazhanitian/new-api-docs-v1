{
  "openapi": "3.1.0",
  "info": {
    "title": "添加音轨",
    "version": "1.0.0",
    "description": "在现有音轨上叠加一条 stem。用 `task_id` + `audio_index` 引用源。版本 `v6` / `v6-wild` / `v6-mini`。不支持 `auto_lyrics`、`persona_id`、`instrumental`、`vocal_gender`、目标时长。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "添加音轨",
        "description": "在现有音轨上叠加一条 stem。\n\n- 用产出源音轨那次任务的 `task_id` + `audio_index`（1-based，默认 1）引用 `music[]` 中的音轨，无需额外 id。缺失或无法解析源时提交期直接 400。\n- `version`：`v6` / `v6-wild` / `v6-mini`，省略默认 `v6`。使用 `custom_model_id` 时省略。`custom_model_id` 与 `version` 互斥。\n- `custom` 决定哪些字段生效。不传时按此推断：有 `prompt` → `true`；无 `prompt` 但有 `gpt_description` → `false`；否则有 `tags` 或 `title` → `true`。已提交字段无论当前模式是否生效，都须满足类型、范围和长度。\n- `custom=true` 时 `prompt`、`title`、`tags`、`negative_tags`、`style_weight`、`weirdness`、`audio_weight` 生效，`gpt_description` 被忽略。`custom=false` 时只读 `gpt_description`（必填，缺失提交期 400、不扣费）。\n- 不支持 `auto_lyrics`、`persona_id`、`instrumental`、`vocal_gender`、目标时长。`max_mode` 启用要求自定义模式，按普通售价的 2 倍计费。创意度用 `weirdness`，兼容旧名 `weirdness_constraint`。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-add-stem",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-add-stem",
                    "description": "固定填写 `suno-add-stem`。",
                    "examples": ["suno-add-stem"]
                  },
                  "task_id": {
                    "type": "string",
                    "description": "产出源音轨那次任务的 ID，必填。缺失或无法解析源时提交期直接返回 400。"
                  },
                  "audio_index": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 1,
                    "description": "源任务结果 `music[]` 中的第几首（1-based，默认 1；一次生成通常 2 首：索引 1 与 2）。"
                  },
                  "version": {
                    "type": "string",
                    "enum": ["v6", "v6-wild", "v6-mini"],
                    "default": "v6",
                    "description": "公共版本：`v6` / `v6-wild` / `v6-mini`。省略默认 `v6`。使用 `custom_model_id` 时省略。"
                  },
                  "custom_model_id": {
                    "type": "string",
                    "description": "创建模型任务返回的完整 UUID，与 `version` 互斥。"
                  },
                  "custom": {
                    "type": "boolean",
                    "description": "`true` 为自定义模式，`prompt` 作歌词；`false` 为灵感模式，用 `gpt_description`。省略时按内容推断：有 `prompt` → `true`；无 `prompt` 但有 `gpt_description` → `false`；否则有 `tags` 或 `title` → `true`。"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "歌词。仅 `custom=true` 时生效，灵感模式下被忽略。"
                  },
                  "gpt_description": {
                    "type": "string",
                    "description": "灵感提示词。`custom=false` 时必填，缺失提交期直接返回 400、不扣费。`custom=true` 时被忽略。"
                  },
                  "title": {
                    "type": "string",
                    "description": "标题。仅 `custom=true` 时生效。"
                  },
                  "tags": {
                    "type": "string",
                    "description": "风格标签。仅 `custom=true` 时生效。"
                  },
                  "negative_tags": {
                    "type": "string",
                    "description": "要排除的风格标签。仅 `custom=true` 时生效。"
                  },
                  "style_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "风格权重，范围 0.00–1.00。越界提交期直接返回 400。仅 `custom=true` 时生效。"
                  },
                  "weirdness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "创意权重，范围 0.00–1.00。兼容旧名 `weirdness_constraint`；新请求请使用 `weirdness`。"
                  },
                  "audio_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "音频权重，范围 0.00–1.00。仅 `custom=true` 时生效。"
                  },
                  "variety": {
                    "type": "string",
                    "enum": ["off", "normal", "high", "extra", "max"],
                    "description": "风格变化程度：`off` / `normal` / `high` / `extra` / `max`。"
                  },
                  "max_mode": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否启用 Max 模式。启用时要求自定义模式，并按普通售价的 2 倍计费。"
                  },
                  "audio_format": {
                    "type": "string",
                    "enum": ["mp3", "m4a", "wav"],
                    "description": "输出音频格式：`mp3` / `m4a` / `wav`。本接口不支持目标时长字段。"
                  }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-add-stem": {
                  "summary": "添加音轨",
                  "value": {
                    "model": "suno-add-stem",
                    "task_id": "task_01ABC",
                    "audio_index": 1,
                    "version": "v6",
                    "custom": false,
                    "gpt_description": "加入温暖的弦乐声部"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "description": "响应状态码。", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "description": "提交结果，读取 `data[0].task_id` 并轮询任务查询接口。",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"], "description": "任务状态。`submitted` 表示已提交。" },
                          "task_id": { "type": "string", "description": "任务 ID，用于轮询 `GET /v1/music/generations/{task_id}`。" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [{ "status": "submitted", "task_id": "task_01K8SGYNNNVBQTXNR4MM964S7K" }]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
