{
  "openapi": "3.1.0",
  "info": {
    "title": "添加音轨",
    "version": "1.0.0",
    "description": "在现有音轨上叠加一条 stem。版本 `v6` / `v6-wild` / `v6-mini`。不支持 `auto_lyrics`、`persona_id`、`instrumental`、`vocal_gender`、目标时长。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "添加音轨",
        "description": "在现有音轨上叠加一条 stem。\n\n- 用产出源音轨那次任务的 `task_id` + `audio_index`（默认 1）引用源，无需额外 id。\n- `version`：`v6` / `v6-wild` / `v6-mini`，默认 `v6`；与 `custom_model_id` 互斥。\n- `custom=false` 时 `gpt_description` 必填。已提交字段无论模式是否生效都须通过校验。\n- 不支持：`auto_lyrics`、`persona_id`、`instrumental`、`vocal_gender`、目标时长。\n- `max_mode` 要求自定义模式，2 倍计费。新请求用 `weirdness`。",
        "operationId": "suno-add-stem",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-add-stem", "description": "固定填写 `suno-add-stem`。", "examples": ["suno-add-stem"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1, "description": "源任务结果 `music[]` 第几首，1-based，默认 1。" },
                  "version": { "type": "string", "enum": ["v6", "v6-wild", "v6-mini"], "default": "v6", "description": "公共版本，省略默认 `v6`。" },
                  "custom_model_id": { "type": "string", "description": "自定义模型 UUID，与 `version` 互斥。" },
                  "custom": { "type": "boolean", "description": "`true` 用 `prompt` 作歌词；`false` 用 `gpt_description`（必填）。不传则按内容推断。" },
                  "prompt": { "type": "string", "description": "歌词，`custom=true` 时生效。" },
                  "gpt_description": { "type": "string", "description": "灵感提示词。`custom=false` 时必填。" },
                  "title": { "type": "string" },
                  "tags": { "type": "string" },
                  "negative_tags": { "type": "string" },
                  "style_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "weirdness": { "type": "number", "minimum": 0, "maximum": 1, "description": "创意度。新请求用本字段。" },
                  "weirdness_constraint": { "type": "number", "minimum": 0, "maximum": 1, "description": "`weirdness` 兼容旧名。" },
                  "audio_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "variety": { "type": "string", "enum": ["off", "normal", "high", "extra", "max"] },
                  "max_mode": { "type": "boolean", "default": false, "description": "Max 模式，启用要求自定义模式，2 倍计费。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"] }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-add-stem": {
                  "summary": "添加音轨",
                  "value": {
                    "model": "suno-add-stem",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "version": "v6",
                    "custom": false,
                    "gpt_description": "加入温暖的弦乐声部"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
