{
  "openapi": "3.1.0",
  "info": {
    "title": "添加音轨",
    "version": "1.0.0",
    "description": "向已有歌曲添加新的音轨或乐器层，适用于丰富现有编曲。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- `version` 仅支持 `v5.5`，省略时也使用 `v5.5`；不要传其他版本，否则会报错或导致任务超时。\n- `custom=true` 时使用 `prompt`；`custom=false` 时 `gpt_description` 必填。模式不匹配的字段会被静默忽略。\n- 省略 `custom` 时依次根据 `prompt`、`gpt_description`、`tags`/`title` 推断模式。\n- 任务完成后，从结果 `music[]` 中读取 `audio_url`；通常需要 30–120 秒，建议每 3–5 秒查询。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "添加音轨",
        "description": "向已有歌曲添加新的音轨或乐器层，适用于丰富现有编曲。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- `version` 仅支持 `v5.5`，省略时也使用 `v5.5`；不要传其他版本，否则会报错或导致任务超时。\n- `custom=true` 时使用 `prompt`；`custom=false` 时 `gpt_description` 必填。模式不匹配的字段会被静默忽略。\n- 省略 `custom` 时依次根据 `prompt`、`gpt_description`、`tags`/`title` 推断模式。\n- 任务完成后，从结果 `music[]` 中读取 `audio_url`；通常需要 30–120 秒，建议每 3–5 秒查询。",
        "operationId": "suno-add-stem",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-add-stem",
                    "description": "固定填写 `suno-add-stem`。",
                    "examples": [
                      "suno-add-stem"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "description": "生成版本，**仅支持 `v5.5`**，默认 `v5.5`。传其他版本（`v3.5`/`v4` 报错，`v4.5`/`v5` 会卡在 10% 直到超时）。",
                    "examples": [
                      "v5.5"
                    ],
                    "enum": [
                      "v5.5"
                    ],
                    "default": "v5.5"
                  },
                  "task_id": {
                    "type": "string",
                    "description": "产出源音轨的任务 ID，必填。",
                    "examples": [
                      "task_source123"
                    ]
                  },
                  "audio_index": {
                    "type": "integer",
                    "description": "源任务结果 `music[]` 中的音轨序号，1-based，默认 `1`。",
                    "examples": [
                      1
                    ],
                    "default": 1,
                    "minimum": 1
                  },
                  "custom": {
                    "type": "boolean",
                    "description": "`true` 为自定义模式，`false` 为灵感模式；省略时根据请求内容推断。"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "歌词，仅 `custom=true` 时生效。"
                  },
                  "gpt_description": {
                    "type": "string",
                    "description": "灵感提示词，`custom=false` 时必填。"
                  },
                  "title": {
                    "type": "string",
                    "description": "标题，仅 `custom=true` 时生效。"
                  },
                  "tags": {
                    "type": "string",
                    "description": "风格标签，仅 `custom=true` 时生效。"
                  },
                  "negative_tags": {
                    "type": "string",
                    "description": "需要排除的风格标签，仅 `custom=true` 时生效。"
                  },
                  "style_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "风格权重，范围 0–1，仅 `custom=true` 时生效。"
                  },
                  "weirdness_constraint": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "创意权重，范围 0–1，仅 `custom=true` 时生效。"
                  },
                  "audio_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "音频权重，范围 0–1，仅 `custom=true` 时生效。"
                  }
                },
                "required": [
                  "model",
                  "task_id"
                ]
              },
              "examples": {
                "suno-add-stem": {
                  "summary": "添加音轨",
                  "value": {
                    "model": "suno-add-stem",
                    "version": "v5.5",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "custom": true,
                    "prompt": "加入一条旋律性电吉他音轨",
                    "tags": "melodic electric guitar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "task_id is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}
