{
  "openapi": "3.1.0",
  "info": {
    "title": "风格翻唱",
    "version": "1.0.0",
    "description": "以另一种风格翻唱已有歌曲。源用 `task_id` + `audio_index`。版本 `v6` / `v6-wild` / `v6-mini`。不传 `custom` 时：有 `prompt`→自定义；无 `prompt` 但有 `gpt_description`→灵感；否则有 `tags`/`title`→自定义。`custom=false` 时 `gpt_description` 必填。已提交字段无论当前模式是否生效都必须通过校验。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "风格翻唱",
        "description": "以另一种风格翻唱已有歌曲。\n\n- 源音轨：`task_id`（必填）+ `audio_index`（1-based，默认 1）。\n- `version`：`v6` / `v6-wild` / `v6-mini`，默认 `v6`；与 `custom_model_id` 互斥。\n- `custom=true`：`prompt`/`title`/`tags`/`negative_tags`/`style_weight`/`weirdness`/`audio_weight`/`persona_id` 生效。\n- `custom=false`：只认 `gpt_description`（必填，缺了 400）。\n- 不传 `custom` 推断顺序：有 `prompt`→true；无 prompt 有 `gpt_description`→false；否则有 `tags`/`title`→true。\n- 给 `tags` 即可按自定义风格翻唱（推荐用法）。\n- `max_mode` 要求自定义模式，2 倍计费。`duration_s` 仅自定义。新请求用 `weirdness`。",
        "operationId": "suno-cover",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-cover", "description": "固定填写 `suno-cover`。", "examples": ["suno-cover"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "description": "源任务 `result.music[]` 第几首，1-based，默认 1。" },
                  "version": { "type": "string", "enum": ["v6", "v6-wild", "v6-mini"], "default": "v6", "description": "公共版本，省略默认 `v6`。用自定义模型时省略。" },
                  "custom_model_id": { "type": "string", "description": "自定义模型 UUID。与 `version`、`persona_id` 互斥。" },
                  "custom": { "type": "boolean", "description": "`true` 自定义（`prompt` 作歌词）；`false` 灵感（`gpt_description`）。不传则按内容推断。" },
                  "prompt": { "type": "string", "description": "歌词，`custom=true` 时生效。" },
                  "gpt_description": { "type": "string", "description": "灵感提示词。`custom=false` 时必填，缺了提交期 400。" },
                  "title": { "type": "string", "description": "标题。仅 `custom=true`。" },
                  "tags": { "type": "string", "description": "目标风格标签。仅 `custom=true`。给 tags 会自动按自定义处理。" },
                  "negative_tags": { "type": "string", "description": "排除风格。仅 `custom=true`。" },
                  "style_weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "风格权重。仅 `custom=true`。" },
                  "weirdness": { "type": "number", "minimum": 0, "maximum": 1, "description": "创意度。新请求用本字段。" },
                  "weirdness_constraint": { "type": "number", "minimum": 0, "maximum": 1, "description": "`weirdness` 兼容旧名。" },
                  "audio_weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "音频权重。仅 `custom=true`。" },
                  "vocal_gender": { "type": "string", "enum": ["Male", "Female"], "description": "人声性别，两种模式均生效。" },
                  "persona_id": { "type": "string", "description": "Persona ID。仅 `custom=true`，与 `custom_model_id` 互斥。" },
                  "duration_s": { "type": "number", "minimum": 10, "maximum": 360, "description": "目标时长 10–360 秒，仅 `custom=true`。" },
                  "variety": { "type": "string", "enum": ["off", "normal", "high", "extra", "max"] },
                  "max_mode": { "type": "boolean", "default": false, "description": "Max 模式。启用要求自定义模式，2 倍计费。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"] }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-cover-tags": {
                  "summary": "指定风格翻唱（推荐）",
                  "value": {
                    "model": "suno-cover",
                    "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw",
                    "audio_index": 1,
                    "version": "v6",
                    "tags": "piano, ambient"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
