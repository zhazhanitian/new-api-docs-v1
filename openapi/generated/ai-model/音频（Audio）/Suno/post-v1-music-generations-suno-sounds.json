{
  "openapi": "3.1.0",
  "info": {
    "title": "音效生成",
    "version": "1.0.0",
    "description": "根据文本描述生成短音效或循环音效，适用于视频、游戏和音乐制作。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- `version` 仅支持 `v5` 和 `v5.5`，省略时上游默认使用 `v5.5`。\n- **官方建议尽量使用英文音效描述**，以获得更好的生成效果。\n- 任务完成后，从结果 `data.result.music[]` 中读取生成音效的 `audio_url`。\n- 建议每 3–5 秒查询一次公共任务接口；生成中状态为 `pending`，`progress` 值排队约 10、就绪约 50、完成为 100。\n- 失败时 `data.error.message` 为原因，平台自动退回预扣额度。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "音效生成",
        "description": "根据文本描述生成短音效或循环音效，适用于视频、游戏和音乐制作。\n\n- 所有 Suno 能力均通过 MAPI 公共提交接口调用；模型由请求体中的 `model` 字段区分。\n- 提交成功后立即返回 MAPI 公开任务 ID。请通过 `GET /v1/music/generations/{task_id}` 轮询任务状态。\n- `version` 仅支持 `v5` 和 `v5.5`，省略时上游默认使用 `v5.5`。\n- **官方建议尽量使用英文音效描述**，以获得更好的生成效果。\n- 任务完成后，从结果 `data.result.music[]` 中读取生成音效的 `audio_url`。\n- 建议每 3–5 秒查询一次公共任务接口；生成中状态为 `pending`，`progress` 值排队约 10、就绪约 50、完成为 100。\n- 失败时 `data.error.message` 为原因，平台自动退回预扣额度。",
        "operationId": "suno-sounds",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-sounds",
                    "description": "固定填写 `suno-sounds`。",
                    "examples": [
                      "suno-sounds"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "description": "生成版本，仅支持 `v5`、`v5.5`，默认 `v5.5`。",
                    "examples": [
                      "v5"
                    ],
                    "enum": [
                      "v5",
                      "v5.5"
                    ],
                    "default": "v5.5"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "音效文本描述，**必填**；缺失时提交期直接返回 400（不扣费）。官方建议优先使用英文以获得更佳效果。"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "one-shot",
                      "loop"
                    ],
                    "description": "音效类型：`one-shot` 为单次音效，`loop` 为可循环音效。",
                    "default": "one-shot"
                  },
                  "bpm": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300,
                    "description": "音效速度，范围 1–300；超出范围时提交期直接返回 400（key param error）。"
                  },
                  "key": {
                    "type": "string",
                    "description": "调性。支持 12 个大调（`C`、`C#`、`D`、`D#`、`E`、`F`、`F#`、`G`、`G#`、`A`、`A#`、`B`）及对应小调（后缀 `m`，如 `Cm`、`C#m` 等）。**仅支持升号（`#`）写法**，降号写法（`Db`、`Eb` 等）及 `B#` 会返回 400（key param error）。",
                    "examples": [
                      "Cm"
                    ],
                    "enum": [
                      "C",
                      "C#",
                      "D",
                      "D#",
                      "E",
                      "F",
                      "F#",
                      "G",
                      "G#",
                      "A",
                      "A#",
                      "B",
                      "Cm",
                      "C#m",
                      "Dm",
                      "D#m",
                      "Em",
                      "Fm",
                      "F#m",
                      "Gm",
                      "G#m",
                      "Am",
                      "A#m",
                      "Bm"
                    ]
                  }
                },
                "required": [
                  "model",
                  "prompt"
                ]
              },
              "examples": {
                "suno-sounds": {
                  "summary": "音效生成",
                  "value": {
                    "model": "suno-sounds",
                    "version": "v5.5",
                    "prompt": "森林中由远及近的雷声和雨声",
                    "type": "one-shot",
                    "bpm": 90,
                    "key": "Cm"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "task_id is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}