{
  "openapi": "3.1.0",
  "info": {
    "title": "音效生成",
    "version": "1.0.0",
    "description": "根据描述生成音效。版本 `v6` / `v6-wild` / `v6-mini`，默认 `v6`。不支持自定义模型、Max、`variety` 或目标时长。完成后从 `result.music[]` 取 `audio_url`。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "音效生成",
        "description": "根据描述生成音效。\n\n- 提交后通过 `GET /v1/music/generations/{task_id}` 轮询。\n- `version`：`v6` / `v6-wild` / `v6-mini`，省略默认 `v6`。\n- 不支持自定义模型、Max、`variety` 或目标时长字段，不要发送。\n- `prompt` 必填，建议尽量使用英文。完成后从 `result.music[]` 取 `audio_url`。进度 0–100，不保证固定节点。",
        "operationId": "suno-sounds",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-sounds",
                    "description": "固定填写 `suno-sounds`。",
                    "examples": [
                      "suno-sounds"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "description": "公共版本：`v6` / `v6-wild` / `v6-mini`；省略时默认 `v6`。",
                    "examples": ["v6"],
                    "enum": ["v6", "v6-wild", "v6-mini"],
                    "default": "v6"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "音效文本描述，**必填**；缺失时提交期直接返回 400（不扣费）。官方建议优先使用英文以获得更佳效果。"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "one-shot",
                      "loop"
                    ],
                    "description": "音效类型：`one-shot` 为单次音效，`loop` 为可循环音效。",
                    "default": "one-shot"
                  },
                  "bpm": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300,
                    "description": "音效速度，范围 1–300；超出范围时提交期直接返回 400（key param error）。"
                  },
                  "key": {
                    "type": "string",
                    "description": "调性。支持 12 个大调（`C`、`C#`、`D`、`D#`、`E`、`F`、`F#`、`G`、`G#`、`A`、`A#`、`B`）及对应小调（后缀 `m`，如 `Cm`、`C#m` 等）。**仅支持升号（`#`）写法**，降号写法（`Db`、`Eb` 等）及 `B#` 会返回 400（key param error）。",
                    "examples": [
                      "Cm"
                    ],
                    "enum": [
                      "C",
                      "C#",
                      "D",
                      "D#",
                      "E",
                      "F",
                      "F#",
                      "G",
                      "G#",
                      "A",
                      "A#",
                      "B",
                      "Cm",
                      "C#m",
                      "Dm",
                      "D#m",
                      "Em",
                      "Fm",
                      "F#m",
                      "Gm",
                      "G#m",
                      "Am",
                      "A#m",
                      "Bm"
                    ]
                  },
                  "audio_format": {
                    "type": "string",
                    "description": "输出音频格式：`mp3` / `m4a` / `wav`。",
                    "enum": ["mp3", "m4a", "wav"]
                  }
                },
                "required": [
                  "model",
                  "prompt"
                ]
              },
              "examples": {
                "suno-sounds": {
                  "summary": "音效生成",
                  "value": {
                    "model": "suno-sounds",
                    "version": "v6",
                    "prompt": "森林中由远及近的雷声和雨声",
                    "type": "one-shot",
                    "bpm": 90,
                    "key": "Cm"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "task_id is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}