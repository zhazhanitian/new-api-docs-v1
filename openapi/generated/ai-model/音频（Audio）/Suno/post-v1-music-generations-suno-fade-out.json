{
  "openapi": "3.1.0",
  "info": {
    "title": "淡出",
    "version": "1.0.0",
    "description": "为已有音轨添加结尾淡出。无版本维度。`duration_s` 为 number，必须大于 0 且不超过源时长。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "淡出",
        "description": "结尾淡出。\n\n- 用 `task_id` + `audio_index`（默认 1）引用源音轨。\n- **无版本维度**：不要传 `version`。\n- `duration_s` 必填，类型为 number（支持小数秒），必须大于 0 且不能超过已知源时长。\n- `title` 省略时默认 `Untitled`。\n- 完成后从 `result.music[]` 取处理后的 `audio_url`。通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-fade-out",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-fade-out", "description": "固定填写 `suno-fade-out`。", "examples": ["suno-fade-out"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1 },
                  "duration_s": { "type": "number", "exclusiveMinimum": 0, "description": "淡出时长（秒），必填。必须大于 0 且不超过源时长，支持小数秒。" },
                  "title": { "type": "string", "default": "Untitled", "description": "标题，默认 `Untitled`。" }
                },
                "required": ["model", "task_id", "duration_s"]
              },
              "examples": {
                "suno-fade-out": {
                  "summary": "淡出",
                  "value": {
                    "model": "suno-fade-out",
                    "task_id": "task_source123",
                    "audio_index": 1,
                    "duration_s": 3,
                    "title": "Fade Out Version"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "duration_s is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
