{
  "openapi": "3.1.0",
  "info": {
    "title": "生成歌词",
    "version": "1.0.0",
    "description": "根据主题生成歌词文本。本端点无版本维度，不要传 `version`。`prompt` 必填。完成后优先读 `result.lyrics[]` 的 `text` / `title` / `tags`。"
  },
  "tags": [
    {
      "name": "音频（Audio）/Suno"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": [
          "音频（Audio）/Suno"
        ],
        "summary": "生成歌词",
        "description": "根据主题生成歌词文本。\n\n- 提交成功后返回 MAPI 公开任务 ID，通过 `GET /v1/music/generations/{task_id}` 轮询。\n- 本模型无版本维度，不要传 `version`；传入会被丢弃，不影响计费。\n- `prompt` 必填，去掉首尾空白后不能为空。\n- `lyrics_model` 可选 `classic` / `remi`，不传使用服务默认。\n- 完成后优先读取 `result.lyrics[]` 的 `text`、`title`、`tags`；同时兼容 `result.text`、字符串 `result.lyrics` 以及历史数组结构。\n- 进度 0–100，不保证固定节点。失败时平台自动退回预扣额度。",
        "operationId": "suno-lyrics",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "suno-lyrics",
                    "description": "固定填写 `suno-lyrics`。",
                    "examples": [
                      "suno-lyrics"
                    ]
                  },
                  "prompt": {
                    "type": "string",
                    "description": "想生成什么歌词的描述，去掉首尾空白后不能为空。"
                  },
                  "lyrics_model": {
                    "type": "string",
                    "enum": [
                      "classic",
                      "remi"
                    ],
                    "description": "歌词模型：`classic` / `remi`。不传时使用服务默认设置。"
                  }
                },
                "required": [
                  "model",
                  "prompt"
                ]
              },
              "examples": {
                "suno-lyrics": {
                  "summary": "生成歌词",
                  "value": {
                    "model": "suno-lyrics",
                    "prompt": "写一首关于夏夜海边重逢的中文流行歌词",
                    "lyrics_model": "classic"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "examples": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "submitted"
                            ]
                          },
                          "task_id": {
                            "type": "string",
                            "description": "MAPI 公开任务 ID，用于公共查询接口。",
                            "examples": [
                              "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                            ]
                          }
                        },
                        "required": [
                          "status",
                          "task_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": [
                    {
                      "status": "submitted",
                      "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误、模型版本不支持或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误代码",
                      "examples": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "错误说明"
                    },
                    "data": {
                      "description": "错误附加数据，可为空"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                "example": {
                  "code": "invalid_request",
                  "message": "prompt is required",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  }
}