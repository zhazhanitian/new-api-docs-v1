{
  "openapi": "3.1.0",
  "info": {
    "title": "BPM 分析",
    "version": "1.0.0",
    "description": "分析歌曲 BPM。无版本维度。完成后读取 `result.avg_bpm`、`result.min_bpm`、`result.max_bpm`。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "BPM 分析",
        "description": "分析歌曲 BPM。\n\n- 用 `task_id` + `audio_index`（默认 1）引用源音轨。\n- **无版本维度**：不要传 `version`。\n- 完成后读取 `result.avg_bpm`、`result.min_bpm` 和 `result.max_bpm`。字段可能为字符串或数字，转换后应检查是否为有限数值。\n- 通过 `GET /v1/music/generations/{task_id}` 轮询。",
        "operationId": "suno-bpm",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-bpm", "description": "固定填写 `suno-bpm`。", "examples": ["suno-bpm"] },
                  "task_id": { "type": "string", "description": "产出源音轨的任务 ID，必填。" },
                  "audio_index": { "type": "integer", "default": 1, "minimum": 1 }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-bpm": {
                  "summary": "BPM 分析",
                  "value": {
                    "model": "suno-bpm",
                    "task_id": "task_source123",
                    "audio_index": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源任务无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
