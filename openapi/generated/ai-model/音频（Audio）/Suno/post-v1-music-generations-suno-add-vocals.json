{
  "openapi": "3.1.0",
  "info": {
    "title": "添加人声",
    "version": "1.0.0",
    "description": "给现有伴奏 / 音轨叠加人声。源必须来自 `suno-upload` 上传任务，普通生成任务不能作源。版本 `v6` / `v6-wild` / `v6-mini`。不支持 `auto_lyrics`、`persona_id`、`instrumental`、目标时长。"
  },
  "tags": [{ "name": "音频（Audio）/Suno" }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 MAPI Bearer Token 认证。格式：`Authorization: Bearer sk-xxxxxx`。"
      }
    }
  },
  "paths": {
    "/v1/music/generations": {
      "post": {
        "tags": ["音频（Audio）/Suno"],
        "summary": "添加人声",
        "description": "给现有（伴奏 / 音轨）叠加人声。\n\n- 源必须来自 `suno-upload`（上游 `uploadTask`）。用该任务 `task_id` + `audio_index`（默认 1）。普通生成任务不能作为源。\n- `version`：`v6` / `v6-wild` / `v6-mini`，默认 `v6`；与 `custom_model_id` 互斥。\n- `custom=false` 时 `gpt_description` 必填。已提交字段无论模式是否生效都须通过校验。\n- 不支持：`auto_lyrics`、`persona_id`、`instrumental`、目标时长字段，不要发送。\n- `max_mode` 要求自定义模式，2 倍计费。新请求用 `weirdness`。",
        "operationId": "suno-add-vocals",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "const": "suno-add-vocals", "description": "固定填写 `suno-add-vocals`。", "examples": ["suno-add-vocals"] },
                  "task_id": { "type": "string", "description": "suno-upload 上传任务的 ID，必填。普通生成任务不可用。" },
                  "audio_index": { "type": "integer", "default": 1, "description": "上传任务 `result.music[]` 第几首，1-based，默认 1。" },
                  "version": { "type": "string", "enum": ["v6", "v6-wild", "v6-mini"], "default": "v6", "description": "公共版本，省略默认 `v6`。" },
                  "custom_model_id": { "type": "string", "description": "自定义模型 UUID，与 `version` 互斥。" },
                  "custom": { "type": "boolean", "description": "`true` 用 `prompt` 作歌词；`false` 用 `gpt_description`（必填）。不传则按内容推断。" },
                  "prompt": { "type": "string", "description": "歌词，`custom=true` 时生效。" },
                  "gpt_description": { "type": "string", "description": "灵感提示词。`custom=false` 时必填。" },
                  "title": { "type": "string" },
                  "tags": { "type": "string" },
                  "negative_tags": { "type": "string" },
                  "style_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "weirdness": { "type": "number", "minimum": 0, "maximum": 1, "description": "创意度。新请求用本字段。" },
                  "weirdness_constraint": { "type": "number", "minimum": 0, "maximum": 1, "description": "`weirdness` 兼容旧名。" },
                  "audio_weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "vocal_gender": { "type": "string", "enum": ["Male", "Female"], "description": "人声性别，两种模式均生效。" },
                  "variety": { "type": "string", "enum": ["off", "normal", "high", "extra", "max"] },
                  "max_mode": { "type": "boolean", "default": false, "description": "Max 模式，启用要求自定义模式，2 倍计费。" },
                  "audio_format": { "type": "string", "enum": ["mp3", "m4a", "wav"] }
                },
                "required": ["model", "task_id"]
              },
              "examples": {
                "suno-add-vocals": {
                  "summary": "添加人声",
                  "value": {
                    "model": "suno-add-vocals",
                    "task_id": "task_uploadXXXXXXXX",
                    "audio_index": 1,
                    "version": "v6",
                    "custom": true,
                    "prompt": "[Verse]\\n夜色铺满窗台",
                    "tags": "indie pop, female vocal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "examples": [200] },
                    "message": { "type": "string", "examples": ["success"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": { "type": "string", "enum": ["submitted"] },
                          "task_id": { "type": "string" }
                        },
                        "required": ["status", "task_id"]
                      }
                    }
                  },
                  "required": ["code", "data"]
                },
                "example": { "code": 200, "message": "success", "data": [{ "status": "submitted", "task_id": "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw" }] }
              }
            }
          },
          "400": {
            "description": "请求参数错误或源不是上传任务",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "examples": ["invalid_request"] },
                    "message": { "type": "string" },
                    "data": { "description": "错误附加数据，可为空" }
                  },
                  "required": ["code", "message"]
                },
                "example": { "code": "invalid_request", "message": "task_id is required", "data": null }
              }
            }
          }
        }
      }
    }
  }
}
