{
  "openapi": "3.1.0",
  "info": {
    "title": "明眸视频生成",
    "version": "2.0.0",
    "description": "提交明眸视频生成任务。请求地址与统一视频接口相同：`POST /v1/video/generations`。\n\n立即返回任务 ID，可通过 `GET /v1/video/generations/{task_id}` 查询。\n\n仅文生视频。不传时长、分辨率、宽高比，也不传素材。\n"
  },
  "tags": [
    {
      "name": "视频（Videos）/明眸系列"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 Bearer Token 认证。\n格式: `Authorization: Bearer sk-xxxxxx`\n"
      }
    }
  },
  "paths": {
    "/v1/video/generations": {
      "post": {
        "tags": [
          "视频（Videos）/明眸系列"
        ],
        "summary": "明眸视频生成",
        "description": "提交明眸视频生成任务。仅文生。不传时长、分辨率、宽高比。",
        "operationId": "createMingmouVideoGeneration",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "description": "视频生成请求",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID。\n\n| 模型 | 说明 |\n|---|---|\n| Mingmou 1.0 | 文生。不传时长、分辨率、宽高比 |\n",
                    "examples": [
                      "mingmou-video-1.0"
                    ]
                  },
                  "prompt": {
                    "type": "string",
                    "description": "文本描述提示词。必填。",
                    "examples": [
                      "小猫慢慢睁开眼睛，轻轻伸了个懒腰"
                    ]
                  },
                  "seed": {
                    "type": "integer",
                    "description": "随机种子，控制生成结果可复现性。",
                    "examples": [
                      20231234
                    ]
                  },
                  "metadata": {
                    "type": "object",
                    "description": "扩展参数。\n\n| 字段 | 类型 | 说明 |\n|---|---|---|\n| `negative_prompt` | string | 反向提示词 |\n| `enhance_prompt` | string | 自动优化提示词，`Enabled` / `Disabled` |\n| `enhance_switch` | string | 视频超分增强，`Enabled` / `Disabled` |\n",
                    "additionalProperties": true,
                    "properties": {
                      "negative_prompt": {
                        "type": "string",
                        "description": "反向提示词。"
                      },
                      "enhance_prompt": {
                        "type": "string",
                        "enum": [
                          "Enabled",
                          "Disabled"
                        ],
                        "description": "自动优化提示词，`Enabled` / `Disabled`。",
                        "examples": [
                          "Enabled"
                        ]
                      },
                      "enhance_switch": {
                        "type": "string",
                        "enum": [
                          "Enabled",
                          "Disabled"
                        ],
                        "description": "视频超分增强，`Enabled` / `Disabled`。",
                        "examples": [
                          "Enabled"
                        ]
                      }
                    },
                    "x-apifox-orders": [
                      "negative_prompt",
                      "enhance_prompt",
                      "enhance_switch"
                    ]
                  }
                },
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "seed",
                  "metadata"
                ]
              },
              "examples": {
                "mingmou-video-1-0": {
                  "summary": "Mingmou 1.0 文生视频",
                  "value": {
                    "model": "mingmou-video-1.0",
                    "prompt": "小猫慢慢睁开眼睛，轻轻伸了个懒腰",
                    "seed": 20231234
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功创建视频生成任务",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string",
                      "description": "任务 ID，用于 GET /v1/video/generations/{task_id} 查询状态",
                      "examples": [
                        "task_aehCmxJ5YUNOIQGgkhvxaco4T9P2h3Dw"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "NOT_START"
                      ],
                      "description": "任务初始状态。请用 GET 接口轮询最终状态。",
                      "examples": [
                        "queued"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "task_id",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "错误信息"
                        },
                        "type": {
                          "type": "string",
                          "description": "错误类型"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "相关参数"
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "错误代码"
                        }
                      },
                      "x-apifox-orders": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
