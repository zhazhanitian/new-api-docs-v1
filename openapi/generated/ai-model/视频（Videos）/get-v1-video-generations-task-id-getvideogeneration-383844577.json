{
  "openapi": "3.1.0",
  "info": {
    "title": "获取视频生成任务状态",
    "version": "1.0.0",
    "description": "查询视频生成任务的状态和结果。\n\n任务状态：\n- `queued`: 排队中\n- `in_progress`: 生成中\n- `success`: 已完成\n- `failed`: 失败\n"
  },
  "tags": [
    {
      "name": "视频（Videos）"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 Bearer Token 认证。\n格式: `Authorization: Bearer sk-xxxxxx`\n"
      }
    }
  },
  "paths": {
    "/v1/video/generations/{task_id}": {
      "get": {
        "tags": [
          "视频（Videos）"
        ],
        "summary": "获取视频生成任务状态",
        "description": "查询视频生成任务的状态和结果。\n\n任务状态：\n- `queued`: 排队中\n- `in_progress`: 生成中\n- `success`: 已完成\n- `failed`: 失败\n",
        "operationId": "getvideogeneration",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "任务 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "视频任务状态查询响应",
                  "properties": {
                    "task_id": {
                      "type": "string",
                      "description": "任务 ID",
                      "examples": [
                        "abcd1234efgh"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "description": "任务状态",
                      "enum": [
                        "queued",
                        "in_progress",
                        "success",
                        "failed"
                      ],
                      "examples": [
                        "success"
                      ]
                    },
                    "progress": {
                      "type": "string",
                      "description": "生成进度百分比",
                      "examples": [
                        "50%"
                      ]
                    },
                    "model": {
                      "type": "string",
                      "description": "实际使用的模型名",
                      "examples": [
                        "doubao-seedance-2-0-260128"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "description": "视频资源 URL（成功时）",
                      "examples": [
                        "https://example.com/video.mp4"
                      ]
                    },
                    "created_at": {
                      "type": "integer",
                      "description": "任务创建时间戳（Unix 秒）",
                      "examples": [
                        1719820800
                      ]
                    },
                    "completed_at": {
                      "type": "integer",
                      "description": "任务完成时间戳（Unix 秒），未完成时为 0",
                      "examples": [
                        1719820860
                      ]
                    },
                    "metadata": {
                      "type": "object",
                      "description": "视频任务元数据，具体字段因渠道不同而有所差异",
                      "properties": {
                        "duration": {
                          "type": "number",
                          "description": "实际生成的视频时长（秒）",
                          "examples": [
                            5
                          ]
                        },
                        "fps": {
                          "type": "integer",
                          "description": "实际帧率（部分渠道返回）",
                          "examples": [
                            24
                          ]
                        },
                        "seed": {
                          "type": "integer",
                          "description": "使用的随机种子",
                          "examples": [
                            20231234
                          ]
                        },
                        "resolution": {
                          "type": "string",
                          "description": "实际输出分辨率（豆包 Seedance 系列）",
                          "examples": [
                            "1080P"
                          ]
                        },
                        "ratio": {
                          "type": "string",
                          "description": "实际输出宽高比（豆包 Seedance 系列）",
                          "examples": [
                            "16:9"
                          ]
                        }
                      },
                      "x-apifox-orders": [
                        "duration",
                        "fps",
                        "seed",
                        "resolution",
                        "ratio"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "description": "失败时的错误信息",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "错误码"
                        },
                        "message": {
                          "type": "string",
                          "description": "错误信息"
                        }
                      },
                      "x-apifox-orders": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "task_id",
                    "status",
                    "progress",
                    "model",
                    "url",
                    "created_at",
                    "completed_at",
                    "metadata",
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "错误信息"
                        },
                        "type": {
                          "type": "string",
                          "description": "错误类型"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "相关参数"
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "错误代码"
                        }
                      },
                      "x-apifox-orders": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
